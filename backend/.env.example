PORT=4000
DB_PATH=./data/vision-log.sqlite3
TIMEZONE=Asia/Seoul

# 초기 Admin 계정 (운영 배포 전 반드시 변경)
BOOTSTRAP_ADMIN_LOGIN_ID=admin
BOOTSTRAP_ADMIN_PASSWORD=1234

# 클라우드(원격 조회용) 대시보드 복제 — 비워두면 비활성화.
# cloud-dashboard/ 를 Cloudflare Pages에 배포한 뒤 그 URL과 SYNC_API_KEY를 채운다.
# CLOUD_SYNC_URL=https://your-dashboard.pages.dev
# CLOUD_SYNC_API_KEY=change-me
